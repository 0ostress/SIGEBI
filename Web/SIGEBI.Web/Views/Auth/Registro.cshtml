@model SIGEBI.Business.DTOs.RegisterDTO

@{
    ViewData["Title"] = "Registro";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SIGEBI — Registro</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #0f0f1a;
            color: #e2e8f0;
            font-family: 'Segoe UI', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .register-card {
            background: #1a1a2e;
            border: 1px solid #2d2d4e;
            border-radius: 16px;
            padding: 2.5rem;
            width: 100%;
            max-width: 480px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.3);
        }
        .register-title {
            font-size: 2rem;
            font-weight: 900;
            background: linear-gradient(135deg, #a855f7, #3b82f6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-align: center;
            margin-bottom: 0.3rem;
        }
        .register-subtitle {
            color: #94a3b8;
            text-align: center;
            font-size: 0.9rem;
            margin-bottom: 2rem;
        }
        .form-control, .form-select {
            background: rgba(255,255,255,0.05) !important;
            border: 1px solid #2d2d4e !important;
            color: #e2e8f0 !important;
            border-radius: 8px;
            padding: 0.75rem 1rem;
        }
        .form-control:focus, .form-select:focus {
            border-color: #7c3aed !important;
            box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.2) !important;
        }
        .form-label { color: #94a3b8; font-weight: 500; }
        .btn-register {
            background: linear-gradient(135deg, #7c3aed, #2563eb);
            border: none;
            color: white;
            padding: 0.75rem;
            border-radius: 8px;
            font-weight: 600;
            width: 100%;
            transition: all 0.3s ease;
        }
        .btn-register:hover { opacity: 0.85; color: white; }
        .alert-error {
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid #ef4444;
            color: #ef4444;
            padding: 0.75rem 1rem;
            border-radius: 8px;
            margin-bottom: 1rem;
        }
        .alert-exito {
            background: rgba(16, 185, 129, 0.15);
            border: 1px solid #10b981;
            color: #10b981;
            padding: 0.75rem 1rem;
            border-radius: 8px;
            margin-bottom: 1rem;
        }
        .login-link { color: #7c3aed; text-decoration: none; }
        .login-link:hover { color: #a855f7; }
        select option { background-color: #1a1a2e; color: #e2e8f0; }
    </style>
</head>
<body>
    <div class="register-card">
        <div class="register-title">SIGEBI</div>
        <div class="register-subtitle">Crear nueva cuenta</div>

        @if (TempData["Error"] != null)
        {
            <div class="alert-error">✗ @TempData["Error"]</div>
        }
        @if (TempData["Exito"] != null)
        {
            <div class="alert-exito">✓ @TempData["Exito"]</div>
        }

        <form method="post" asp-action="Registro">
            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <input type="text" name="Nombre" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Apellido</label>
                <input type="text" name="Apellido" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Correo Electrónico</label>
                <input type="email" name="Email" class="form-control" placeholder="correo@itla.edu.do" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Contraseña</label>
                <input type="password" name="Password" class="form-control" required />
            </div>
            <div class="mb-4">
                <label class="form-label">Rol</label>
                <select name="Rol" class="form-select">
                    <option value="Estudiante">Estudiante</option>
                    <option value="Docente">Docente</option>
                    <option value="Bibliotecario">Bibliotecario</option>
                </select>
            </div>
            <button type="submit" class="btn-register">Crear Cuenta</button>
        </form>

        <div class="text-center mt-3" style="color: #94a3b8; font-size: 0.9rem;">
            ¿Ya tienes cuenta? <a asp-action="Login" class="login-link">Inicia sesión aquí</a>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>