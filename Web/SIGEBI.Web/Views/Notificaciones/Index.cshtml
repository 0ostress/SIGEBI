@model IEnumerable<SIGEBI.Domain.Entities.Notificacion>

@{
    ViewData["Title"] = "Notificaciones";
}

<div class="sigebi-card">
    <h2>Notificaciones</h2>
    <p class="descripcion">
        Aquí puedes ver todas tus notificaciones recientes sobre préstamos aprobados y eventos del sistema.
    </p>

    @if (!Model.Any())
    {
        <div style="text-align: center; padding: 3rem; color: #94a3b8;">
            <p style="font-size: 2rem;">🔔</p>
            <p style="font-size: 1.1rem;">No tienes notificaciones nuevas.</p>
        </div>
    }
    else
    {
        @foreach (var n in Model)
        {
            <div style="background: rgba(124,58,237,0.1); border: 1px solid #2d2d4e; border-radius: 10px; padding: 1rem 1.5rem; margin-bottom: 1rem;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span style="color: #7c3aed; font-weight: 600; font-size: 0.85rem;">@n.Tipo</span>
                    <span style="color: #94a3b8; font-size: 0.8rem;">@n.FechaCreacion.ToShortDateString()</span>
                </div>
                <p style="color: #e2e8f0; margin: 0.5rem 0 0;">@n.Mensaje</p>
            </div>
        }
    }

    <div class="mt-3">
        <a asp-controller="Home" asp-action="Index" class="btn-outline-sigebi">Volver al Inicio</a>
    </div>
</div>