@model IEnumerable<SIGEBI.Business.DTOs.PrestamoDTO>

@{
    ViewData["Title"] = "Mis Préstamos";
    var nombre = Context.Session.GetString("Nombre");
}

<div class="sigebi-card">
    <h2>Mis Préstamos</h2>
    <p class="descripcion">
        Aquí puedes consultar todos tus préstamos activos e historial. Puedes renovar préstamos activos que no hayan vencido.
    </p>

    @if (!Model.Any())
    {
        <div style="text-align: center; padding: 3rem; color: #94a3b8;">
            <p style="font-size: 1.1rem;">No tienes préstamos registrados.</p>
            <a asp-action="Solicitar" class="btn-sigebi">Solicitar un Préstamo</a>
        </div>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Recurso</th>
                    <th>Fecha Inicio</th>
                    <th>Fecha Vencimiento</th>
                    <th>Fecha Devolución</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var prestamo in Model)
                {
                    <tr>
                        <td>@prestamo.TituloRecurso</td>
                        <td>@prestamo.FechaInicio.ToShortDateString()</td>
                        <td>@prestamo.FechaVencimiento.ToShortDateString()</td>
                        <td>
                            @if (prestamo.FechaDevolucion.HasValue)
                            {
                                @prestamo.FechaDevolucion.Value.ToShortDateString()
                            }
                            else
                            {
                                <span class="badge-inactivo">Pendiente</span>
                            }
                        </td>
                        <td>
                            <span class="@(prestamo.Estado == "Activo" ? "badge-activo" : prestamo.Estado == "Vencido" || prestamo.Estado == "Rechazado" ? "badge-vencido" : prestamo.Estado == "Pendiente" ? "badge-inactivo" : "badge-devuelto")">
                                @prestamo.Estado
                            </span>
                        </td>
                        <td>
                           @if (prestamo.Estado == "Activo" && prestamo.FechaVencimiento > DateTime.Now)
{
    @if (prestamo.CantidadRenovaciones >= 1)
    {
        <span class="badge-inactivo">Ya renovado</span>
    }
    else
    {
        <form method="post" asp-action="Renovar" style="display:inline"
              onsubmit="return confirm('¿Deseas renovar este préstamo por 7 días más? Solo puedes renovar una vez por préstamo.')">
            <input type="hidden" name="prestamoId" value="@prestamo.Id" />
            <button type="submit" class="btn-outline-sigebi">Renovar +7 días</button>
        </form>
    }
}
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="mt-3">
            <a asp-action="Solicitar" class="btn-sigebi">Solicitar Nuevo Préstamo</a>
        </div>
    }
</div>