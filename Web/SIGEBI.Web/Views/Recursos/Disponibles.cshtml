@model IEnumerable<SIGEBI.Business.DTOs.RecursoDTO>

@{
    ViewData["Title"] = "Recursos Disponibles";
}

<div class="sigebi-card">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <h2>Catálogo Bibliográfico</h2>
            <p class="descripcion">
                Explora los recursos bibliográficos disponibles para préstamo.
                Haz clic en un libro para ver más detalles o agrégalo al carrito para solicitar el préstamo.
            </p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div style="text-align:center; padding:3rem; color:#94a3b8;">
            <p style="font-size:1.1rem;">No hay recursos disponibles en este momento.</p>
        </div>
    }
    else
    {
        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(220px, 1fr)); gap:1.5rem; margin-top:1rem;">
            @foreach (var recurso in Model)
            {
                <div style="background:#16213e; border:1px solid #2d2d4e; border-radius:14px; overflow:hidden; transition:all 0.3s; box-shadow:0 4px 15px rgba(0,0,0,0.3);"
                     onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 8px 25px rgba(124,58,237,0.3)'"
                     onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(0,0,0,0.3)'">

                    <a asp-controller="Recursos" asp-action="Detalle" asp-route-id="@recurso.Id" style="text-decoration:none;">
                        <div style="height:200px; background:linear-gradient(135deg,#1a1a2e,#16213e); display:flex; align-items:center; justify-content:center; overflow:hidden;">
                            @if (!string.IsNullOrEmpty(recurso.ImagenUrl))
                            {
                                <img src="@($"http://localhost:5200{recurso.ImagenUrl}")" alt="@recurso.Titulo"
                                     style="width:100%; height:100%; object-fit:cover;" />
                            }
                            else
                            {
                                <div style="text-align:center; color:#2d2d4e;">
                                    <p style="font-size:3rem; margin:0;">📚</p>
                                    <p style="font-size:0.75rem; color:#4a4a6a; margin:0;">Sin portada</p>
                                </div>
                            }
                        </div>
                    </a>

                    <div style="padding:1rem;">
                        <a asp-controller="Recursos" asp-action="Detalle" asp-route-id="@recurso.Id" style="text-decoration:none;">
                            <h4 style="color:#e2e8f0; font-size:0.95rem; font-weight:700; margin:0 0 0.3rem; line-height:1.3;">@recurso.Titulo</h4>
                        </a>
                        <p style="color:#94a3b8; font-size:0.8rem; margin:0 0 0.3rem;">@recurso.Autor</p>
                        <p style="color:#64748b; font-size:0.75rem; margin:0 0 0.5rem;">@recurso.Categoria</p>

                        @if (!string.IsNullOrEmpty(recurso.Descripcion))
                        {
                            <p style="color:#94a3b8; font-size:0.78rem; margin:0 0 0.8rem; line-height:1.4;
                                      display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden;">
                                @recurso.Descripcion
                            </p>
                        }

                        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:0.5rem;">
                            <span class="badge-activo">@recurso.CantidadDisponible disponibles</span>
                            <button onclick="agregarAlCarrito(@recurso.Id, '@recurso.Titulo.Replace("'", "\'")', '@recurso.Autor.Replace("'", "\'")')"
                                    style="background:linear-gradient(135deg,#7c3aed,#2563eb); color:white; padding:0.35rem 0.8rem; border-radius:6px; font-size:0.8rem; border:none; font-weight:600; cursor:pointer;">
                                + Carrito
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
<script>
    async function agregarAlCarrito(id, titulo, autor) {
        if (confirm(`¿Deseas agregar "${titulo}" al carrito de solicitudes?`)) {
            const response = await fetch('/Carrito/Agregar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `recursoId=${id}&titulo=${encodeURIComponent(titulo)}&autor=${encodeURIComponent(autor)}`
            });
            const resultado = await response.json();
            if (resultado.exito) {
                const badge = document.getElementById('navbar-carrito-badge');
                if (badge) {
                    badge.style.display = 'inline';
                    badge.textContent = resultado.cantidad;
                }
                alert(`✅ "${titulo}" agregado al carrito. Tienes ${resultado.cantidad} libro(s).`);
            }
        }
    }
</script>
}
