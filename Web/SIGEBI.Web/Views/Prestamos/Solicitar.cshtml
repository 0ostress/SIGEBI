@{
    ViewData["Title"] = "Solicitar Préstamo";
}

<div class="sigebi-card" style="max-width: 600px; margin: 0 auto;">
    <h2>Solicitar Préstamo</h2>
    <p class="descripcion">
        Ingresa el ID del usuario y el ID del recurso bibliográfico que deseas prestar. 
        El sistema verificará automáticamente que el usuario esté activo, no tenga penalizaciones 
        y que el recurso tenga ejemplares disponibles antes de registrar el préstamo.
    </p>

    <form method="post" asp-action="Solicitar">
        <div class="mb-3">
            <label class="form-label">ID del Usuario</label>
            <input type="number" name="usuarioId" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">ID del Recurso Bibliografico</label>
            <input type="number" name="recursoId" class="form-control" required />
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn-sigebi">Solicitar</button>
            <a asp-action="Index" class="btn-outline-sigebi">Cancelar</a>
        </div>
    </form>
</div>