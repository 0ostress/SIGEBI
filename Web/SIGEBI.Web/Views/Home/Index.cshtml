@{
    ViewData["Title"] = "Inicio";
    var rol = Context.Session.GetString("Rol");
    var nombre = Context.Session.GetString("Nombre");
}

<div class="sigebi-card text-center" style="margin-top: 3rem; padding: 4rem 2rem;">
    <h1 style="font-size: 4rem; font-weight: 900; background: linear-gradient(135deg, #a855f7, #3b82f6, #7c3aed); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; letter-spacing: 0.3rem; filter: drop-shadow(0 0 30px rgba(124, 58, 237, 0.5));">
        SIGEBI
    </h1>
    <p style="color: #94a3b8; font-size: 1.1rem; margin-bottom: 0.5rem;">
        Sistema de Gestión de Bibliotecas Institucional
    </p>
    <hr style="border-color: #2d2d4e; margin: 2rem auto; width: 60%;" />

    <p style="color: #e2e8f0; font-size: 1.1rem; margin-bottom: 2rem;">
        Bienvenido, <strong>@nombre</strong> — <span style="color: #7c3aed;">@rol</span>
    </p>

    @if (rol == "Administrador" || rol == "Bibliotecario")
    {
        <p style="color: #94a3b8; max-width: 700px; margin: 0 auto 2rem;">
            Tienes acceso completo al sistema. Puedes gestionar usuarios, recursos bibliográficos, 
            préstamos, devoluciones y penalizaciones.
        </p>
        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
            <a asp-controller="Usuarios" asp-action="Index" class="btn-sigebi">Gestionar Usuarios</a>
            <a asp-controller="Recursos" asp-action="Index" class="btn-sigebi">Gestionar Recursos</a>
            <a asp-controller="Prestamos" asp-action="Index" class="btn-sigebi">Ver Préstamos</a>
            <a asp-controller="Devoluciones" asp-action="Index" class="btn-sigebi">Devoluciones</a>
            <a asp-controller="Penalizaciones" asp-action="Index" class="btn-sigebi">Penalizaciones</a>
        </div>
    }
    else if (rol == "Estudiante" || rol == "Docente")
    {
        <p style="color: #94a3b8; max-width: 700px; margin: 0 auto 2rem;">
            Puedes consultar el catálogo de recursos disponibles, solicitar préstamos 
            y consultar tus penalizaciones activas.
        </p>
        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
            <a asp-controller="Recursos" asp-action="Disponibles" class="btn-sigebi">Ver Catálogo</a>
            <a asp-controller="Prestamos" asp-action="Solicitar" class="btn-sigebi">Solicitar Préstamo</a>
            <a asp-controller="Penalizaciones" asp-action="Index" class="btn-sigebi">Mis Penalizaciones</a>
        </div>
    }
