@{
    ViewData["Title"] = "Solicitar Préstamo";
    var rol = Context.Session.GetString("Rol");
    var nombre = Context.Session.GetString("Nombre");
    var exito = TempData["ExitoSolicitud"] as bool? ?? false;
}

@if (exito)
{
    <div class="sigebi-card" style="max-width: 600px; margin: 0 auto; text-align: center;">
        <div style="font-size: 3rem; margin-bottom: 1rem;">✅</div>
        <h2>Solicitud Enviada</h2>
        <p class="descripcion">
            Tu solicitud de préstamo fue enviada exitosamente. El bibliotecario la revisará y recibirás una notificación cuando sea aprobada.
        </p>
        <div class="d-flex gap-2 justify-content-center mt-3">
            <a asp-action="Solicitar" class="btn-sigebi">Solicitar Otro</a>
            <a asp-controller="Home" asp-action="Index" class="btn-outline-sigebi">Ir al Inicio</a>
        </div>
    </div>
}
else
{
    <div class="sigebi-card" style="max-width: 600px; margin: 0 auto;">
        <h2>Solicitar Préstamo</h2>
        <p class="descripcion">
            Selecciona el recurso bibliográfico que deseas solicitar.
            El bibliotecario revisará tu solicitud y recibirás una notificación cuando sea aprobada.
        </p>

        <form method="post" asp-action="Solicitar">
            @if (rol == "Bibliotecario")
            {
                <div class="mb-3">
                    <label class="form-label">Usuario</label>
                    <select name="usuarioId" class="form-select" required>
                        <option value="">-- Selecciona un usuario --</option>
                        @foreach (var usuario in ViewBag.Usuarios)
                        {
                            <option value="@usuario.Id">@usuario.Nombre @usuario.Apellido — @usuario.Rol</option>
                        }
                    </select>
                </div>
            }
            else
            {
                <input type="hidden" name="usuarioId" value="@ViewBag.UsuarioId" />
                <div class="mb-3" style="background: rgba(124,58,237,0.1); border: 1px solid #2d2d4e; border-radius: 8px; padding: 1rem;">
                    <p style="color: #94a3b8; margin: 0; font-size: 0.9rem;">Solicitando como:</p>
                    <p style="color: #e2e8f0; margin: 0; font-weight: 600;">@nombre</p>
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Recurso Bibliográfico</label>
                <select name="recursoId" class="form-select" required>
                    <option value="">-- Selecciona un recurso --</option>
                    @foreach (var recurso in ViewBag.Recursos)
                    {
                        <option value="@recurso.Id">@recurso.Titulo — @recurso.Autor (@recurso.CantidadDisponible disponibles)</option>
                    }
                </select>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn-sigebi">Solicitar Préstamo</button>
                <a asp-controller="Home" asp-action="Index" class="btn-outline-sigebi">Cancelar</a>
            </div>
        </form>
    </div>
}