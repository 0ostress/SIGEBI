@model IEnumerable<SIGEBI.Business.DTOs.PrestamoDTO>

@{
    ViewData["Title"] = "Préstamos";
    var rol = Context.Session.GetString("Rol");
}

<div class="sigebi-card">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <h2>Gestión de Préstamos</h2>
            <p class="descripcion">
                Historial completo de préstamos del sistema incluyendo activos, devueltos y rechazados.
            </p>
        </div>
        @if (rol == "Estudiante" || rol == "Docente")
        {
            <a asp-action="Solicitar" class="btn-sigebi">+ Solicitar Préstamo</a>
        }
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Usuario</th>
                <th>Recurso</th>
                <th>Fecha Inicio</th>
                <th>Fecha Vencimiento</th>
                <th>Estado</th>
                @if (rol == "Bibliotecario" || rol == "Administrador")
                {
                    <th>Acciones</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var prestamo in Model)
            {
                <tr>
                    <td>@prestamo.NombreUsuario</td>
                    <td>@prestamo.TituloRecurso</td>
                    <td>@prestamo.FechaInicio.ToShortDateString()</td>
                    <td>@prestamo.FechaVencimiento.ToShortDateString()</td>
                    <td>
                        <span class="@(prestamo.Estado == "Activo" ? "badge-activo" : prestamo.Estado == "Vencido" || prestamo.Estado == "Rechazado" ? "badge-vencido" : prestamo.Estado == "Pendiente" ? "badge-inactivo" : "badge-devuelto")">
                            @prestamo.Estado
                        </span>
                    </td>
                    @if (rol == "Bibliotecario" || rol == "Administrador")
                    {
                        <td>
                            @if (prestamo.Estado == "Activo")
                            {
                                <form method="post" asp-controller="Devoluciones" asp-action="Registrar" style="display:inline">
                                    <input type="hidden" name="prestamoId" value="@prestamo.Id" />
                                    <button type="submit" class="btn-outline-sigebi">Devolver</button>
                                </form>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>