@model SIGEBI.Business.DTOs.LoginDTO

@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SIGEBI — Iniciar Sesión</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
body {
    background-color: #0f0f1a;
    color: #e2e8f0;
    font-family: 'Segoe UI', sans-serif;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center; 
    margin: 0;
    padding: 2rem;
}

.login-card {
    background: #1a1a2e;
    border: 1px solid #2d2d4e;
    border-radius: 16px;
    padding: 3rem;
    width: 100%;
    max-width: 420px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.3);
}
        .login-title {
            font-size: 2rem;
            font-weight: 900;
            background: linear-gradient(135deg, #a855f7, #3b82f6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-align: center;
            margin-bottom: 0.3rem;
        }
        .login-subtitle {
            color: #94a3b8;
            text-align: center;
            font-size: 0.9rem;
            margin-bottom: 2rem;
        }


        .form-control {
            background: rgba(255,255,255,0.05) !important;
            border: 1px solid #2d2d4e !important;
            color: #e2e8f0 !important;
            border-radius: 8px;
            padding: 0.75rem 1rem;
        }
        .form-control:focus {
            border-color: #7c3aed !important;
            box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.2) !important;
        }
        .form-label { color: #94a3b8; font-weight: 500; }
        .btn-login {
            background: linear-gradient(135deg, #7c3aed, #2563eb);
            border: none;
            color: white;
            padding: 0.75rem;
            border-radius: 8px;
            font-weight: 600;
            width: 100%;
            transition: all 0.3s ease;
        }
        .btn-login:hover { opacity: 0.85; color: white; }
        .alert-error {
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid #ef4444;
            color: #ef4444;
            padding: 0.75rem 1rem;
            border-radius: 8px;
            margin-bottom: 1rem;
        }
        .register-link { color: #7c3aed; text-decoration: none; }
        .register-link:hover { color: #a855f7; }

html, body {
    height: 100%;
    margin: 0;
    padding: 0;
}

body {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    min-height: 100vh !important;
    background-color: #0f0f1a !important;
}

.login-card {
    background: #1a1a2e;
    border: 1px solid #2d2d4e;
    border-radius: 16px;
    padding: 3rem;
    width: 100%;
    max-width: 420px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.3);
    margin: auto;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
}


    </style>
</head>
<body style="display:flex; align-items:center; justify-content:center; min-height:100vh; margin:0; padding:2rem; background-color:#0f0f1a;">
    <div class="login-card">
        <div class="login-title">SIGEBI</div>
        <div class="login-subtitle">Sistema de Gestión de Bibliotecas Institucional</div>

        @if (TempData["Error"] != null)
        {
            <div class="alert-error">✗ @TempData["Error"]</div> 
        }

        <form method="post" asp-action="Login">
            <div class="mb-4" style="margin-bottom: 1.5rem !important;">
                <label class="form-label">Correo Electrónico</label>
                <input type="email" name="Email" class="form-control" placeholder="correo@itla.edu.do" required />
            </div>
            <div class="mb-4" style="margin-bottom: 1.5rem !important;">
                <label class="form-label">Contraseña</label>
                <input type="password" name="Password" class="form-control" placeholder="••••••••" required />
            </div>
            <div class="mt-4">
                <button type="submit" class="btn-login">Iniciar Sesión</button>
            </div>
        </form>

        <div class="text-center mt-3" style="color: #94a3b8; font-size: 0.9rem;">
            ¿No tienes cuenta? <a asp-action="Registro" class="register-link">Regístrate aquí</a>
        </div>
        <div class="text-center mt-2" style="color: #64748b; font-size: 0.75rem;">
            ¿Eres personal administrativo? Contacta al equipo técnico para obtener acceso.
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>